# Copy this file to `keystore.properties` (same folder) and fill in your real values.
# `keystore.properties` is git-ignored and must NEVER be committed.
#
# 1. Generate a release keystore (one-time). Run from the repo root and keep the .jks safe/backed up
#    — if you lose it you can no longer ship updates under the same signing identity:
#
#    keytool -genkeypair -v -keystore grayzone-release.jks -alias grayzone -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Fill in the values below to match what you entered above.
# 3. Build a signed release:  .\gradlew.bat :app:assembleRelease   (APK)
#                        or:  .\gradlew.bat :app:bundleRelease     (AAB, for Play)

# Path to the keystore file, relative to the repo root (or an absolute path).
storeFile=grayzone-release.jks

# Password for the keystore.
storePassword=CHANGE_ME

# Key alias you chose with -alias above.
keyAlias=grayzone

# Password for that key (often the same as storePassword).
keyPassword=CHANGE_ME
